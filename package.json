{
	"name": "mason",
	"private": true,
	"description": "An agent runtime for building, connecting and running AI agents.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Necto-AI/mason.git"
	},
	"homepage": "https://github.com/Necto-AI/mason#readme",
	"license": "AGPL-3.0-only",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w mason-agent",
		"dev:stack": "npm run dev:stack -w mason-agent",
		"init": "npm run init -w mason-agent",
		"new": "npm run new -w mason-agent",
		"doctor": "npm run doctor -w mason-agent",
		"status": "npm run status -w mason-agent",
		"chat": "npm run chat -w mason-agent",
		"prompt": "npm run prompt -w mason-agent",
		"integration": "npm run integration -w mason-agent",
		"connector": "npm run connector -w mason-agent",
		"eval": "npm run eval -w mason-agent",
		"eval:judge": "npm run eval:judge -w mason-agent",
		"e2e:first-run": "npm run e2e:first-run -w mason-agent",
		"test": "npm run test -w mason-agent",
		"test:ci": "npm run test:ci -w mason-agent",
		"test:packages": "node --experimental-strip-types --experimental-sqlite --test packages/protocol/test/*.test.ts packages/client/test/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
		"gen:surface": "npm run gen:surface -w mason-agent",
		"gen:surface:check": "npm run gen:surface:check -w mason-agent",
		"check:docs": "npm run check:docs -w mason-agent",
		"check:code": "npm run check:code -w mason-agent",
		"check:licence": "node --experimental-strip-types scripts/licence.ts",
		"check:metadata": "node --experimental-strip-types scripts/metadata.ts",
		"build:packages": "npm run build -w mason-protocol && npm run build -w mason-client",
		"build": "npm run build -w mason-agent",
		"prove:client": "node --experimental-strip-types scripts/prove-client-sdk.ts",
		"prove:package": "node --experimental-strip-types scripts/prove-package.ts",
		"prove:ssh-env": "node --experimental-strip-types scripts/prove-ssh-env.ts",
		"prove:share-boundary": "bash scripts/prove-share-boundary.sh",
		"prove:guest-desktop": "bash scripts/prove-guest-desktop.sh",
		"lint": "node scripts/biome.mjs check .",
		"lint:write": "node scripts/biome.mjs check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@types/ws": "8.18.1",
		"typescript": "5.9.3"
	}
}
