{
	"name": "mason-agent",
	"description": "An agent runtime for building, connecting and running AI agents.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Necto-AI/mason.git"
	},
	"homepage": "https://github.com/Necto-AI/mason#readme",
	"keywords": [
		"agent",
		"ai",
		"runtime",
		"connectors",
		"mcp"
	],
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "node --experimental-strip-types packages/mason-agent/src/server/main.ts",
		"dev:stack": "node --experimental-strip-types scripts/dev-stack.ts",
		"init": "node --experimental-strip-types scripts/init.ts",
		"new": "node --experimental-strip-types scripts/new.ts",
		"doctor": "node --experimental-strip-types scripts/doctor.ts",
		"status": "node --experimental-strip-types scripts/status.ts",
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"test:ci": "node --experimental-strip-types --test --test-concurrency=2 --test-shard=${TEST_SHARD:-1/1} test/*.test.ts",
		"test:packages": "node --experimental-strip-types --experimental-sqlite --test packages/protocol/test/*.test.ts packages/connector/test/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"gen:surface": "node --experimental-strip-types scripts/surface.ts",
		"prompt": "node --experimental-strip-types scripts/prompt.ts",
		"gen:surface:check": "node --experimental-strip-types scripts/surface.ts --check",
		"check:docs": "node --experimental-strip-types scripts/doc-budget.ts --check",
		"check:code": "node --experimental-strip-types scripts/code-budget.ts --check",
		"check:licence": "node --experimental-strip-types scripts/licence.ts",
		"check:metadata": "node --experimental-strip-types scripts/metadata.ts",
		"build:packages": "npm run build --workspace mason-protocol && npm run build --workspace mason-connector",
		"prove:connector": "node --experimental-strip-types scripts/prove-connector-sdk.ts",
		"prove:package": "node --experimental-strip-types scripts/prove-package.ts",
		"lint": "node scripts/biome.mjs check .",
		"lint:write": "node scripts/biome.mjs check --write .",
		"eval": "node --experimental-strip-types evals/run.ts",
		"eval:judge": "node --experimental-strip-types evals/judge.ts",
		"integration": "node --experimental-strip-types scripts/integration.ts",
		"connector": "node --experimental-strip-types scripts/connector.ts",
		"pretest": "npm run build:packages",
		"predev": "npm run build:packages",
		"pregen:surface": "npm run build:packages",
		"prebuild": "npm run build:packages",
		"build": "node scripts/build-runtime.ts",
		"prepack": "npm run build",
		"e2e:first-run": "node --experimental-strip-types scripts/e2e-first-run.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"bin": {
		"mason": "dist/bin/mason.js"
	},
	"engines": {
		"node": ">=26.4.0"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-codemode": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@earendil-works/pi-env": "1.5.0",
		"@earendil-works/pi-mcp": "1.5.0",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@types/ws": "8.18.1",
		"typescript": "5.9.3"
	}
}
